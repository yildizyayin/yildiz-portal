{
  "name": "yildiz-deneme-platformu",
  "version": "1.0.0",
  "description": "Yıldız Deneme Platformu - Deneme Sınavı Yönetim Sistemi",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "esbuild src/index.ts --bundle --platform=neutral --target=es2020 --outfile=dist/index.js --external:cloudflare",
    "build:frontend": "vite build",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env development",
    "migrate": "wrangler d1 migrations apply yildiz-deneme-prod",
    "migrate:dev": "wrangler d1 migrations apply yildiz-deneme-dev --local",
    "seed": "wrangler d1 execute yildiz-deneme-prod --file=./migrations/seed.sql",
    "seed:dev": "wrangler d1 execute yildiz-deneme-dev --local --file=./migrations/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240814.0",
    "hono": "^4.2.0",
    "hono-jsx": "^0.0.117",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "xlsx": "^0.18.5",
    "html2pdf.js": "^0.10.1",
    "axios": "^1.7.0",
    "lucide-react": "^0.408.0",
    "clsx": "^2.1.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/wrangler": "^3.62.0",
    "@types/node": "^20.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.55.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "playwright": "^1.48.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/jest-dom": "^6.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
