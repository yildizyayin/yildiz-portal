{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yildiz-deneme-platformu",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-19",
  "build": {
    "command": "npm run build",
    "watch_dir": ["src"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yildiz-deneme-prod",
      "database_id": "b9977324-1294-4bfc-913d-51258c052395"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "Yıldız Deneme Platformu"
  }
}
